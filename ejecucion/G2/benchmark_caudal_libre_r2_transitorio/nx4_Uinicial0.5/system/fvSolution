FoamFile { format ascii; class dictionary; object fvSolution; }
solvers {
p { solver PCG; preconditioner DIC; tolerance 1e-12; relTol 0; maxIter 500; }
U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-12; relTol 0; maxIter 500; }
pFinal { $p; relTol 0; } UFinal { $U; relTol 0; }
} PIMPLE { momentumPredictor on; nOuterCorrectors 10; nCorrectors 2;
nNonOrthogonalCorrectors 0; transportCorrectionFinal no; }
relaxationFactors { equations { ".*" 1; } }
