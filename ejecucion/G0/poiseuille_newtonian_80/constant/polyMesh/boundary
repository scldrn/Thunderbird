5
(
    left
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          80;
        startFace       79;
        matchTolerance  0.0001;
        neighbourPatch  right;
        transformType   translational;
        separation      (-0.2 0 0);
    }
    right
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          80;
        startFace       159;
        matchTolerance  0.0001;
        neighbourPatch  left;
        transformType   translational;
        separation      (0.2 0 0);
    }
    walls
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          1;
        startFace       239;
    }
    centreline
    {
        type            symmetryPlane;
        inGroups        List<word> 1(symmetryPlane);
        nFaces          1;
        startFace       240;
    }
    frontAndBack
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          160;
        startFace       241;
    }
)

