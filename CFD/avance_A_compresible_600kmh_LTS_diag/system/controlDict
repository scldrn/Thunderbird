mass_flux_outlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch outlet; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
mass_flux_farfield {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch farfield; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
hull_pressure_min {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch hull; operation min; writeFields false; fields (p); writeControl timeStep; writeInterval 1;}
hull_pressure_max {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch hull; operation max; writeFields false; fields (p); writeControl timeStep; writeInterval 1;}
}

