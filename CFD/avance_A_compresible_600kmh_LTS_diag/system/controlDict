{version 2.0; format ascii; class dictionary; object controlDict;}
application foamRun; solver fluid; startFrom startTime; startTime 0; stopAt endTime; endTime 200; deltaT 1; writeControl timeStep; writeInterval 25; purgeWrite 3; writeFormat ascii; writePrecision 10; timePrecision 8; runTimeModifiable true;
