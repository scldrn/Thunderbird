/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     | Website:  https://openfoam.org
    \\  /    A nd           | Version:  13
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          writeNow;

endTime         0.03;

deltaT          2e-06;

writeControl    adjustableRunTime;

writeInterval   0.001;

purgeWrite      3;

writeFormat     ascii;

writePrecision  9;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.8;

maxDeltaT       2e-05;

timePrecision   10;

functions
{
    force_vaneX0
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneX0 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( 0 -0.022 -0.012 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_vaneX1
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneX1 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( 0 0 -0.012 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_vaneX2
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneX2 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( 0 0.022 -0.012 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_vaneY0
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneY0 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( -0.022 0 -0.04 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_vaneY1
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneY1 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( 0 0 -0.04 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_vaneY2
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( vaneY2 );
        rho             rhoInf;
        rhoInf          1.225;
        CofR            ( 0.022 0 -0.04 );
        writeControl    timeStep;
        writeInterval   1;
    }
    p_inlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        patch           inlet;
        operation       areaAverage;
        writeFields     false;
        fields          ( p U );
        writeControl    timeStep;
        writeInterval   1;
    }
    flow_inlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        patch           inlet;
        operation       sum;
        writeFields     false;
        fields          ( phi );
        writeControl    timeStep;
        writeInterval   1;
    }
    p_outlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        patch           outlet;
        operation       areaAverage;
        writeFields     false;
        fields          ( p U );
        writeControl    timeStep;
        writeInterval   1;
    }
    flow_outlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        patch           outlet;
        operation       sum;
        writeFields     false;
        fields          ( phi );
        writeControl    timeStep;
        writeInterval   1;
    }
}


// ************************************************************************* //
