FoamFile
{version 2.0; format ascii; class dictionary; object controlDict;}
application foamRun; solver incompressibleFluid; startFrom startTime; startTime 0; stopAt endTime; endTime 0.00025; deltaT 1e-7; writeControl adjustableRunTime; writeInterval 0.00005; purgeWrite 3; writeFormat ascii; writePrecision 10; timePrecision 12; runTimeModifiable true; adjustTimeStep yes; maxCo 0.3; maxDeltaT 1e-5;
functions {
force_vaneX0 {type forces; libs ("libforces.so"); patches (vaneX0); rho rhoInf; rhoInf 1.225; CofR (0 -0.022 -0.012); writeControl timeStep; writeInterval 1;}
force_vaneX1 {type forces; libs ("libforces.so"); patches (vaneX1); rho rhoInf; rhoInf 1.225; CofR (0 0 -0.012); writeControl timeStep; writeInterval 1;}
force_vaneX2 {type forces; libs ("libforces.so"); patches (vaneX2); rho rhoInf; rhoInf 1.225; CofR (0 0.022 -0.012); writeControl timeStep; writeInterval 1;}
force_vaneY0 {type forces; libs ("libforces.so"); patches (vaneY0); rho rhoInf; rhoInf 1.225; CofR (-0.022 0 -0.04); writeControl timeStep; writeInterval 1;}
force_vaneY1 {type forces; libs ("libforces.so"); patches (vaneY1); rho rhoInf; rhoInf 1.225; CofR (0 0 -0.04); writeControl timeStep; writeInterval 1;}
force_vaneY2 {type forces; libs ("libforces.so"); patches (vaneY2); rho rhoInf; rhoInf 1.225; CofR (0.022 0 -0.04); writeControl timeStep; writeInterval 1;}
force_walls {type forces; libs ("libforces.so"); patches (walls); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
force_all_solids {type forces; libs ("libforces.so"); patches (walls "vane.*"); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
force_all_boundary {type forces; libs ("libforces.so"); patches (walls "vane.*" inlet farfield); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
flow_inlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch inlet; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
momentum_flux_inlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch inlet; operation sum; weightField phi; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
flow_farfield {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch farfield; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
momentum_flux_farfield {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch farfield; operation sum; weightField phi; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
volume_velocity {type volFieldValue; libs ("libfieldFunctionObjects.so"); cellZone all; operation volIntegrate; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
maxVelocityDiagnostic {type volFieldValue; log true; libs ("libfieldFunctionObjects.so"); cellZone all; operation maxMag; writeFields false; fields (U); writeControl timeStep; writeInterval 10;}
minScalarsDiagnostic {type volFieldValue; log true; libs ("libfieldFunctionObjects.so"); cellZone all; operation min; writeFields false; fields (p k omega); writeControl timeStep; writeInterval 10;}
}
