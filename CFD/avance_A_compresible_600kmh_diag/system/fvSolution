FoamFile
{version 2.0; format ascii; class dictionary; object fvSolution;}
solvers {p {solver GAMG; smoother GaussSeidel; tolerance 1e-8; relTol 0.01;} "(U|h)" {solver PBiCGStab; preconditioner DILU; tolerance 1e-9; relTol 0.05;}}
PIMPLE {transonic yes; nNonOrthogonalCorrectors 1;}
relaxationFactors {fields {p 0.2; rho 0.1;} equations {U 0.5; h 0.5;}}
