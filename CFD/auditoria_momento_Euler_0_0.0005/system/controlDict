FoamFile
{version 2.0; format ascii; class dictionary; object controlDict;}
application foamRun; solver incompressibleFluid; startFrom startTime; startTime 0; stopAt endTime; endTime 0.0005; deltaT 1e-6; writeControl timeStep; writeInterval 1;
functions {
traction_all_boundary {type forces; libs ("libforces.so"); patches (vaneX0 vaneX1 vaneX2 vaneY0 vaneY1 vaneY2 walls inlet outlet); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
traction_solids {type forces; libs ("libforces.so"); patches (vaneX0 vaneX1 vaneX2 vaneY0 vaneY1 vaneY2 walls); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
traction_open_ends {type forces; libs ("libforces.so"); patches (inlet outlet); rho rhoInf; rhoInf 1.225; CofR (0 0 0); writeControl timeStep; writeInterval 1;}
volume_velocity {type volFieldValue; libs ("libfieldFunctionObjects.so"); cellZone all; operation volIntegrate; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
momentum_flux_inlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch inlet; operation sum; weightField phi; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
flow_inlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch inlet; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
momentum_flux_outlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch outlet; operation sum; weightField phi; writeFields false; fields (U); writeControl timeStep; writeInterval 1;}
flow_outlet {type surfaceFieldValue; libs ("libfieldFunctionObjects.so"); patch outlet; operation sum; writeFields false; fields (phi); writeControl timeStep; writeInterval 1;}
}
